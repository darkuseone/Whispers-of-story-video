 "lines": [
  {
   "t0": 2.2,
   "t1": 4.0,
   "text": "I found a letter in a box of his things",
   "key": [
    "letter"
   ]
  },
  {
   "t0": 4.1,
   "t1": 5.6,
   "text": "Tucked behind a stack of unpaid bills",
   "key": []
  },
  {
   "t0": 5.7,
   "t1": 7.4,
   "text": "Dated 1961",
   "key": [
    "1961"
   ]
  },
  {
   "t0": 7.5,
   "t1": 9.0,
   "text": "Addressed to a name nobody in my family knew",
   "key": []
  },
  {
   "t0": 9.1,
   "t1": 10.6,
   "text": "Signed with a single initial",
   "key": [
    "initial"
   ]
  },
  {
   "t0": 10.8,
   "t1": 12.6,
   "text": "Three days I could not put it down",
   "key": []
  },
  {
   "t0": 12.8,
   "t1": 14.7,
   "text": "Forty years of Sunday dinners",
   "key": [
    "forty"
   ]
  },
  {
   "t0": 14.9,
   "t1": 16.6,
   "text": "He never said a word",
   "key": [
    "never"
   ]
  },
  {
   "t0": 16.8,
   "t1": 18.5,
   "text": "So I started asking",
   "key": []
  },
  {
   "t0": 18.7,
   "t1": 20.4,
   "text": "Nobody would answer me",
   "key": [
    "nobody"
   ]
  },
  {
   "t0": 20.6,
   "t1": 22.3,
   "text": "The more they changed the subject",
   "key": []
  },
  {
   "t0": 22.5,
   "t1": 24.2,
   "text": "The more certain I became",
   "key": []
  },
  {
   "t0": 24.4,
   "t1": 26.2,
   "text": "That letter was not a mistake",
   "key": []
  },
  {
   "t0": 26.4,
   "t1": 28.4,
   "text": "It was the loose end he left behind",
   "key": [
    "loose",
    "end"
   ]
  }
 ]
}
